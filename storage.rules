rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read for gallery and assets
    match /gallery/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role == 'officer';
    }
    match /officers/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role == 'officer';
    }
    match /sponsors/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role == 'officer';
    }
    // Member-only slides
    match /slides/{file} {
      allow read: if false; // locked until Phase 2 auth
      allow write: if false;
    }
  }
}
